# ===== 环境变量示例文件 =====
# 复制为 .env 后按实际情况填写。.env 已被 .gitignore 排除，绝不会被提交。

# 数据库：SQLite 文件路径（相对 server/ 目录）
DATABASE_URL="file:./v2.db"

# 服务端口
PORT=8780

# ★ JWT 密钥：部署时务必改成随机长字符串。
#   生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="请改成你自己的随机字符串"

# ★ 管理员初始密码：首次启动时用于创建 admin 账号，部署后请立即修改。
DEFAULT_ADMIN_PASSWORD="请改成你自己的密码"

# DeepSeek API Key：留空则自动降级为纯统计规则引擎，功能不降级
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# 允许的跨域来源
CORS_ORIGIN="*"